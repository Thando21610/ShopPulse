{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseSqlite": true,
  "ConnectionStrings": {
    "Sqlite": "Data Source=/tmp/shoppulse.db",
    "Default": ""
  },
  "Jwt": {
    "Issuer": "shoppulse-api",
    "Audience": "shoppulse-app",
    "SigningKey": "DEV_ONLY_ShopPulse_SigningKey_Change_In_Production_Min32Chars!",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 60
  },
  "RefreshToken": {
    "CookieName": "sp_rt",
    "CookiePath": "/api/auth",
    "IdleDays": 7,
    "AbsoluteDays": 30
  },
  "Cors": {
    "Origins": [ "*" ]
  }
}
