{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=/tmp/shoppulse.db",
    "Default": ""
  },
  "Jwt": {
    "Issuer": "shoppulse-api",
    "Audience": "shoppulse-app",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 60
  },
  "RefreshToken": {
    "CookieName": "sp_rt",
    "CookiePath": "/api/auth",
    "IdleDays": 7,
    "AbsoluteDays": 30
  },
  "Cors": {
    "Origins": [
      "http://localhost:5000",
      "https://localhost:5001"
    ]
  }
}