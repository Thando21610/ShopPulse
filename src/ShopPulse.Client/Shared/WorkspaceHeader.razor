@using System.Text.Json
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Navigation
@inject ShopPulse.Client.ToastService Toast
@inject HttpClient Http

<header class="feature-header">
    <a href="/" class="brand-lockup" aria-label="ShopPulse overview">
        <img class="brand-mark" src="/brand-mark.svg" alt="" aria-hidden="true" />
        <span><strong>ShopPulse</strong><small>RETAIL WORKSPACE</small></span>
    </a>
    <div class="feature-header-actions">
        <span class="feature-api-status" role="status">
            <span class="status-indicator @(_apiOnline ? "online" : "offline")"></span>
            @(_apiOnline ? "API connected" : "API unavailable")
        </span>
        @if (Session.User is { } user)
        {
            <span class="feature-user-name">@user.DisplayName</span>
            <span class="role-chip">@user.Role</span>
            <button class="button button-quiet feature-signout" type="button" @onclick="SignOutAsync" disabled="@_signingOut">
                @(_signingOut ? "Signing out…" : "Sign out")
            </button>
        }
    </div>
</header>

@code {
    private bool _signingOut, _apiOnline;

    protected override async Task OnInitializedAsync()
    {
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
        try
        {
            using var response = await Http.GetAsync("health", timeout.Token);
            if (!response.IsSuccessStatusCode
                || !string.Equals(response.Content.Headers.ContentType?.MediaType, "application/json", StringComparison.OrdinalIgnoreCase))
                return;

            using var health = await response.Content.ReadFromJsonAsync<JsonDocument>(cancellationToken: timeout.Token);
            _apiOnline = health?.RootElement.TryGetProperty("status", out var status) == true
                && status.GetString() == "ok"
                && health.RootElement.TryGetProperty("service", out var service)
                && service.GetString() == "ShopPulse API";
        }
        catch (HttpRequestException) { _apiOnline = false; }
        catch (JsonException) { _apiOnline = false; }
        catch (OperationCanceledException) { _apiOnline = false; }
    }

    private async Task SignOutAsync()
    {
        if (_signingOut) return;
        _signingOut = true;
        try
        {
            await Session.SignOutAsync();
            Toast.Clear();
            Navigation.NavigateTo("/", replace: true);
        }
        finally
        {
            _signingOut = false;
        }
    }
}