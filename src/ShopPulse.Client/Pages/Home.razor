@page "/"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session

<PageTitle>ShopPulse | Store workspace</PageTitle>

<div class="dashboard-shell">
    <header class="dashboard-header">
        <a class="brand-lockup" href="/" aria-label="ShopPulse home">
            <span class="brand-mark" aria-hidden="true">S</span>
            <span><strong>ShopPulse</strong><small>RETAIL WORKSPACE</small></span>
        </a>
        <div class="header-right">
            <span class="status-indicator @(_apiOnline ? "online" : "offline")"></span>
            <span>@(_apiOnline ? "API connected" : "API unavailable")</span>
            @if (_signedIn)
            {
                <span class="role-chip">@_role</span>
                <button class="button button-quiet" @onclick="LogoutAsync" disabled="@_busy">Sign out</button>
            }
        </div>
    </header>

    <main class="dashboard-main">
        <section class="welcome-row">
            <div>
                <p class="eyebrow">STORE WORKSPACE</p>
                <h1>@(_signedIn ? $"Welcome, {_displayName}" : "A clearer view of your store.")</h1>
                <p class="muted">Simple, reliable tools for everyday retail operations.</p>
            </div>
            <time class="date-chip" datetime="@DateTimeOffset.Now.ToString("yyyy-MM-dd")">@DateTimeOffset.Now.ToString("ddd, dd MMM yyyy")</time>
        </section>

        @if (!_signedIn)
        {
            <section class="login-layout">

                <section class="panel sign-in-panel" aria-labelledby="signin-heading">
                    <div>
                        <p class="eyebrow">SECURE STAFF ACCESS</p>
                        <h2 id="signin-heading">Welcome back</h2>
                        <p class="muted">Sign in using the account provided by your store owner.</p>
                    </div>
                    <EditForm Model="_login" OnValidSubmit="LoginAsync" class="login-form">
                        <DataAnnotationsValidator />
                        <div class="field-group">
                            <label for="email">Email address</label>
                            <InputText id="email" class="form-control" @bind-Value="_login.Email" type="email" autocomplete="username" placeholder="you@yourshop.co.za" />
                            <ValidationMessage For="@(() => _login.Email)" />
                        </div>
                        <div class="field-group">
                            <label for="password">Password</label>
                            <InputText id="password" class="form-control" @bind-Value="_login.Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
                            <ValidationMessage For="@(() => _login.Password)" />
                        </div>
                        <button class="button button-primary" type="submit" disabled="@(_busy || !_apiOnline)">
                            <span class="material-symbols-outlined" aria-hidden="true">login</span>@(_busy ? "Signing in…" : "Sign in securely")
                        </button>
                        @if (!_apiOnline) { <p class="helper-message">ShopPulse is having trouble reaching the service. Please try again shortly.</p> }
                    </EditForm>
                </section>
            </section>
        }
        else
        {
            <ShopPulse.Client.Shared.WorkspaceNav />
            <section class="workspace-toolbar">
                <div>
                    <p class="eyebrow">CATALOGUE</p>
                    <h2><span class="material-symbols-outlined" aria-hidden="true">inventory_2</span> Your products</h2>
                    <p class="muted">Live catalogue data from your store.</p>
                </div>
                <div class="dashboard-actions">
                    <a class="button button-primary" href="/sales"><span class="material-symbols-outlined" aria-hidden="true">point_of_sale</span> New sale</a>
                    @if (_role == "Owner" || Session.User?.CanManageProducts == true) {
                        <a class="button button-quiet" href="/products/manage"><span class="material-symbols-outlined" aria-hidden="true">inventory</span> Manage products</a>
                    }
                    @if (_role == "Owner" || Session.User?.CanReceiveStock == true) {
                        <a class="button button-quiet" href="/stock/receive"><span class="material-symbols-outlined" aria-hidden="true">add_box</span> Receive stock</a>
                    }
                    <span class="count-pill">@_products.Count products</span>
                </div>
            </section>
            <section class="panel products-panel" aria-label="Product catalogue">
                @if (_loadingProducts)
                {
                    <div class="empty-state"><span class="loader" aria-hidden="true"></span><strong>Loading catalogue…</strong><p class="muted">Retrieving the latest product data.</p></div>
                }
                else if (!string.IsNullOrWhiteSpace(_productsError))
                {
                    <div class="empty-state"><strong>Could not load products</strong><p class="muted">@_productsError</p><button class="button button-quiet" @onclick="LoadProductsAsync">Try again</button></div>
                }
                else if (_products.Count == 0)
                {
                    <div class="empty-state"><div class="empty-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M7 15h34l-3-9H10l-3 9Zm3 0v27h28V15M7 15c0 4 7 4 7 0 0 4 7 4 7 0 0 4 7 4 7 0 0 4 7 4 7 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg></div><strong>Your catalogue is empty</strong><p class="muted">Products will appear here once they have been added to your store.</p></div>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th scope="col">PRODUCT</th><th scope="col">SKU</th><th scope="col">AVAILABLE</th><th scope="col">STOCK STATUS</th><th scope="col">UNIT PRICE (ZAR)</th></tr></thead>
                            <tbody>
                                @foreach (var item in _products)
                                {
                                    <tr><td><strong>@item.Name</strong></td><td><span class="sku">@item.Sku</span></td><td>@item.Available</td><td><span class="stock-status @(item.Available <= item.MinimumStockLevel ? "low" : "ok")">@(item.Available <= item.MinimumStockLevel ? "Low stock" : "In stock")</span></td><td>@item.UnitPrice.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="table-note">Prices are displayed in South African Rand (ZAR).</p>
                }
            </section>
            <p class="permission-note">Signed in as @_displayName · @_role access. Permissions are enforced by the API.</p>
        }
    </main>
    <footer class="dashboard-footer"><span>ShopPulse · Smarter operations. Less waste. Better business.</span><span>Store data is served securely by the ShopPulse API.</span></footer>

    @if (!string.IsNullOrWhiteSpace(_toastMessage))
    {
        <div class="toast-host" role="@( _toastIsError ? "alert" : "status")" aria-live="@( _toastIsError ? "assertive" : "polite")">
            <div class="toast-card @(_toastIsError ? "toast-error" : "toast-success")">
                <span class="toast-symbol" aria-hidden="true">@(_toastIsError ? "!" : "✓")</span>
                <div><strong>@(_toastIsError ? "Something needs attention" : "All done")</strong><p>@_toastMessage</p></div>
                <button class="toast-close" aria-label="Dismiss notification" @onclick="ClearToast">×</button>
            </div>
        </div>
    }
</div>

@code {
    private readonly LoginModel _login = new();
    private readonly List<ProductRow> _products = [];
    private bool _signedIn, _busy, _loadingProducts, _apiOnline, _toastIsError;
    private string _displayName = "there", _role = "";
    private string? _productsError, _toastMessage;

    protected override async Task OnInitializedAsync()
    {
        try { using var response = await Http.GetAsync("health"); _apiOnline = response.IsSuccessStatusCode; }
        catch (HttpRequestException) { _apiOnline = false; }
        if (!_apiOnline)
        {
            ShowToast("The service is currently unavailable. Check your connection and try again.", true);
            return;
        }

        // Restore the HttpOnly refresh-cookie session before rendering the sign-in state.
        if (await Session.RestoreAsync())
        {
            _signedIn = true;
            _displayName = Session.User?.DisplayName ?? "there";
            _role = Session.User?.Role ?? "Staff";
            await LoadProductsAsync();
        }
    }

    private async Task LoginAsync()
    {
        _busy = true;
        try
        {
            var result = await Session.SignInAsync(_login.Email.Trim(), _login.Password);
            if (!result.Success)
            {
                ShowToast(result.Message ?? "We couldn't sign you in right now. Please try again.", true);
                return;
            }

            _displayName = Session.User?.DisplayName ?? "there";
            _role = Session.User?.Role ?? "Staff";
            _signedIn = true;
            ShowToast("You're signed in. Welcome to your store workspace.");
            await LoadProductsAsync();
        }
        finally { _busy = false; }
    }

    private async Task LoadProductsAsync()
    {
        _loadingProducts = true; _productsError = null;
        try
        {
            using var response = await Http.GetAsync("api/products");
            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Session.Clear(); _signedIn = false;
                ShowToast("Your session has expired. Please sign in again.", true); return;
            }
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _productsError = "Your account does not have permission to view this catalogue.";
                ShowToast(_productsError, true); return;
            }
            if (!response.IsSuccessStatusCode) { _productsError = "The catalogue could not be loaded. Please try again."; ShowToast(_productsError, true); return; }
            var items = await response.Content.ReadFromJsonAsync<List<ProductRow>>();
            _products.Clear(); if (items is not null) _products.AddRange(items);
        }
        catch (HttpRequestException) { _productsError = "The service could not be reached."; ShowToast(_productsError, true); }
        catch (JsonException) { _productsError = "The catalogue response was invalid."; ShowToast(_productsError, true); }
        finally { _loadingProducts = false; }
    }

    private async Task LogoutAsync()
    {
        await Session.SignOutAsync();
        _products.Clear(); _signedIn = false;
        _login.Password = ""; _displayName = "there"; _role = "";
        ShowToast("You have signed out successfully.");
    }

    private void ShowToast(string message, bool isError = false) { _toastMessage = message; _toastIsError = isError; }
    private void ClearToast() => _toastMessage = null;

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";
        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
    private sealed class ProductRow { public string Name { get; set; } = ""; public string Sku { get; set; } = ""; public decimal UnitPrice { get; set; } public int Available { get; set; } public int MinimumStockLevel { get; set; } }
}