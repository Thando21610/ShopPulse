@page "/not-found"
@layout MainLayout

<PageTitle>Page not found | ShopPulse</PageTitle>

<main class="not-found-shell">
    <div class="not-found-card">
        <div class="not-found-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M8 16h32v25H8zM5 16l4-10h30l4 10M5 16c0 4 7 4 7 0 0 4 7 4 7 0 0 4 7 4 7 0 0 4 7 4 7 0 0 4 7 4 7 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </div>
        <p class="eyebrow">404 · PAGE NOT FOUND</p>
        <h1>We couldn't find that page.</h1>
        <p class="muted">The page may have moved, or the address may be incorrect.</p>
        <a class="button button-primary not-found-link" href="/">Return to workspace</a>
    </div>
</main>

<style>
.not-found-shell{min-height:65vh;display:grid;place-items:center;padding:32px 18px}
.not-found-card{max-width:460px;text-align:center;background:#fff;border:1px solid #e7ece8;border-radius:20px;padding:42px 32px;box-shadow:0 8px 30px rgba(26,55,42,.04)}
.not-found-icon{width:56px;height:56px;margin:0 auto 22px;display:grid;place-items:center;border-radius:16px;background:#edf4ef;color:#28543f}
.not-found-icon svg{width:30px;height:30px}
.not-found-card h1{font:800 26px Manrope,sans-serif;color:#18362b;margin:0 0 10px}
.not-found-link{display:inline-block;text-decoration:none;margin-top:24px}
</style>