@page "/reports"
@using System.Net.Http.Json
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Nav

<PageTitle>Reports | ShopPulse</PageTitle>
<main class="feature-page">
    <header class="feature-header"><a href="/" class="brand-lockup"><span class="brand-mark">S</span><span><strong>ShopPulse</strong><small>RETAIL WORKSPACE</small></span></a><span class="role-chip">Owner reports</span></header>
    <ShopPulse.Client.Shared.WorkspaceNav />
    <section class="feature-heading"><p class="eyebrow">BUSINESS OVERVIEW</p><h1>Daily report</h1><p class="muted">Review sales, payment mix and recorded waste in South African Rand.</p></section>
    @if (_forbidden) { <div class="inline-alert" role="alert">Financial reports are available to the store owner only.</div> }
    else
    {
        <div class="toolbar-row"><label for="report-date">Report date</label><input id="report-date" class="form-control compact-select" type="date" @bind="_date" @bind:after="Load" /><button class="button button-quiet" @onclick="Load">Refresh</button></div>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error</div> }
        @if (_report is not null)
        {
            <section class="metrics-grid">
                <article class="panel metric-card"><span>Net sales total</span><strong>@Money(_report.SalesTotal)</strong><small>@_report.SalesCount sales recorded</small></article>
                <article class="panel metric-card"><span>Refunds issued</span><strong>@Money(_report.RefundTotal)</strong><small>@Money(_report.CashRefundTotal) cash · @Money(_report.CardRefundTotal) card</small></article>
                <article class="panel metric-card"><span>Cash received (net)</span><strong>@Money(_report.CashTotal)</strong><small>After cash refunds</small></article>
                <article class="panel metric-card"><span>Cash in / out</span><strong>@Money(_report.CashIn)</strong><small>Cash out: @Money(_report.CashOut)</small></article>
                <article class="panel metric-card"><span>Card payments</span><strong>@Money(_report.CardTotal)</strong><small>Card transactions</small></article>
                <article class="panel metric-card"><span>Recorded waste</span><strong>@Money(_report.WasteCost)</strong><small>Estimated stock cost</small></article>
                <article class="panel metric-card"><span>Active products</span><strong>@_report.ActiveProducts</strong><small>Current catalogue</small></article>
                <article class="panel metric-card"><span>Sellable units</span><strong>@_report.InventoryUnits</strong><small>Current on-hand quantity</small></article>
                <article class="panel metric-card"><span>Low-stock products</span><strong>@_report.LowStockProducts</strong><small>At or below reorder threshold</small></article>
                <article class="panel metric-card"><span>Staff actions</span><strong>@_report.StaffActions</strong><small>Audit events on selected date</small></article>
                <article class="panel metric-card"><span>Average sale</span><strong>@Money(_report.AverageTransactionValue)</strong><small>Per completed transaction</small></article>
                <article class="panel metric-card"><span>Units received</span><strong>@_report.UnitsReceived</strong><small>Stock receipts on selected date</small></article>
                <article class="panel metric-card"><span>Units sold</span><strong>@_report.UnitsSold</strong><small>Stock deducted through sales</small></article>
                <article class="panel metric-card"><span>Stock adjustments</span><strong>@_report.StockAdjustments</strong><small>Waste and adjustment movements</small></article>
                <article class="panel metric-card"><span>Shifts closed</span><strong>@_report.ClosedShifts</strong><small>Cash shifts reconciled</small></article>
                <article class="panel metric-card"><span>Cash variance</span><strong class="@(_report.CashVariance < 0 ? "text-danger" : "")">@Money(_report.CashVariance)</strong><small>Net variance across closed shifts</small></article>
            </section>
            <p class="muted small-note">Sales and refunds are grouped by their respective transaction/refund dates; stock movements, waste and shift closures follow the selected SAST date. Inventory figures show current stock at report time; staff actions count recorded audit events. All monetary amounts are ZAR.</p>
        }
    }
</main>
@code {
    private DateTime _date = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(2)).Date;
    private ReportSummary? _report;
    private bool _forbidden;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated && !await Session.RestoreAsync()) { Nav.NavigateTo("/"); return; }
        if (Session.User?.Role != "Owner") { _forbidden = true; return; }
        await Load();
    }
    private async Task Load()
    {
        _error = null;
        try { _report = await Http.GetFromJsonAsync<ReportSummary>($"api/reports/summary?date={_date:yyyy-MM-dd}"); }
        catch (HttpRequestException) { _error = "The report could not be loaded."; }
    }
    private static string Money(decimal v) => v.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"));
    private sealed class ReportSummary { public int SalesCount { get; set; } public decimal SalesTotal { get; set; } public decimal RefundTotal { get; set; } public decimal CashRefundTotal { get; set; } public decimal CardRefundTotal { get; set; } public decimal AverageTransactionValue { get; set; } public decimal CashTotal { get; set; } public decimal CardTotal { get; set; } public decimal WasteCost { get; set; } public int ActiveProducts { get; set; } public int InventoryUnits { get; set; } public int LowStockProducts { get; set; } public int StaffActions { get; set; } public int UnitsReceived { get; set; } public int UnitsSold { get; set; } public int StockAdjustments { get; set; } public int ClosedShifts { get; set; } public decimal CashVariance { get; set; } public decimal CashIn { get; set; } public decimal CashOut { get; set; } public string Currency { get; set; } = "ZAR"; }
}