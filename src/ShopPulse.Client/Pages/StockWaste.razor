@page "/stock/waste"
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Nav
@inject ShopPulse.Client.ToastService Toast

<PageTitle>Record waste | ShopPulse</PageTitle>
<main class="feature-page">
    <header class="feature-header"><a href="/" class="brand-lockup"><span class="brand-mark">S</span><span><strong>ShopPulse</strong><small>RETAIL WORKSPACE</small></span></a><span class="role-chip">Inventory</span></header>
    <ShopPulse.Client.Shared.WorkspaceNav />
    <section class="feature-heading"><p class="eyebrow">INVENTORY · LOSS CONTROL</p><h1>Record waste</h1><p class="muted">Record expired, damaged, missing or spoiled stock against its batch.</p></section>
    @if (_forbidden)
    {
        <div class="inline-alert" role="alert">Your account does not have permission to record stock waste. Ask the store owner to grant this permission.</div>
    }
    else
    {
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error</div> }
    <section class="panel form-panel">
        <EditForm EditContext="_editContext" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <div class="field-group full"><label for="batch">Stock batch</label><InputSelect id="batch" class="form-control" @bind-Value="_form.BatchId"><option value="">Choose a batch</option>@foreach(var b in _batches){<option value="@b.Id">@b.ProductName · @b.RemainingQuantity available · @b.BatchReference</option>}</InputSelect><ValidationMessage For="@(() => _form.BatchId)" /></div>
                <div class="field-group"><label for="quantity">Quantity to write off</label><InputNumber id="quantity" class="form-control" @bind-Value="_form.Quantity" min="1" /><ValidationMessage For="@(() => _form.Quantity)" /></div>
                <div class="field-group"><label for="reason">Reason</label><InputSelect id="reason" class="form-control" @bind-Value="_form.Reason"><option>Expired</option><option>Damaged</option><option>Missing</option><option>Spoiled</option><option>Other</option></InputSelect></div>
                <div class="field-group full"><label for="notes">Notes (optional)</label><InputTextArea id="notes" class="form-control" @bind-Value="_form.Notes" maxlength="500" /></div>
            </div>
            <p class="muted small-note">The API verifies the batch, checks available quantity and records the stock movement and audit event together.</p>
            <button class="button button-primary" type="submit" disabled="@_busy || _batches.Count == 0">@(_busy ? "Saving…" : "Record waste")</button>
        </EditForm>
    </section>
    @if (_success) { <div class="toast-inline" role="status">Waste recorded and stock updated.</div> }
    }
</main>

@code {
    private List<BatchOption> _batches = [];
    private WasteForm _form = new();
    private EditContext _editContext = default!;
    private bool _busy, _success, _forbidden;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_form);
        if (!Session.IsAuthenticated && !await Session.RestoreAsync()) { Nav.NavigateTo("/"); return; }
        if (Session.User?.Role != "Owner" && Session.User?.CanAdjustStock != true) { _forbidden = true; return; }
        try { _batches = await Http.GetFromJsonAsync<List<BatchOption>>("api/stock/batches") ?? []; }
        catch (HttpRequestException) { _error = "Could not load stock batches."; }
    }
    private async Task Submit()
    {
        var batch = _batches.FirstOrDefault(x => x.Id == _form.BatchId);
        if (batch is null) { _error = "Choose a stock batch."; return; }
        if (_form.Quantity < 1 || _form.Quantity > batch.RemainingQuantity) { _error = $"Enter a quantity from 1 to {batch.RemainingQuantity}."; return; }
        _busy = true; _error = null; _success = false;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/stock/waste", new { productId = batch.ProductId, stockBatchId = batch.Id, quantity = _form.Quantity, reason = _form.Reason, notes = _form.Notes });
            if (response.IsSuccessStatusCode) { _success = true; _form = new(); _editContext = new EditContext(_form); Toast.ShowSuccess("Waste recorded and stock updated."); _batches = await Http.GetFromJsonAsync<List<BatchOption>>("api/stock/batches") ?? []; return; }
            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest
                && await ApiErrorFormatter.ApplyValidationErrorsAsync(response, _editContext))
                return;
            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _error = "Your account does not have permission to record stock waste. Ask the store owner to grant this permission.";
                return;
            }
            var message = await ApiErrorFormatter.FormatAsync(response, "Waste could not be recorded.");
            if ((int)response.StatusCode >= 500) Toast.ShowError(message); else _error = message;
        }
        catch (HttpRequestException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }
    private sealed class WasteForm
    {
        [Required(ErrorMessage = "Choose a stock batch.")]
        public Guid? BatchId { get; set; }
        [Range(1, 100000, ErrorMessage = "Enter a quantity greater than zero.")]
        public int Quantity { get; set; } = 1;
        public string Reason { get; set; } = "Expired";
        [StringLength(500)] public string? Notes { get; set; }
    }
    private sealed class BatchOption { public Guid Id { get; set; } public Guid ProductId { get; set; } public string ProductName { get; set; } = ""; public string? BatchReference { get; set; } public int RemainingQuantity { get; set; } }
}