@page "/sales"
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Nav
@inject ShopPulse.Client.ToastService Toast
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>New sale | ShopPulse</PageTitle>
<main class="feature-page">
    <header class="feature-header"><a href="/" class="brand-lockup"><span class="brand-mark">S</span><span><strong>ShopPulse</strong><small>RETAIL WORKSPACE</small></span></a><span class="role-chip">New sale</span></header>
    <ShopPulse.Client.Shared.WorkspaceNav />
    <section class="feature-heading"><p class="eyebrow">CHECKOUT · ZAR</p><h1>New sale</h1><p class="muted">Find products, build a basket and take payment.</p></section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error @if (_cashShiftRequired) { <a href="/cash-shift">Open cash shift</a> }</div> }
    @if (_receipt is not null)
    {
        <section class="panel receipt-panel" id="receipt">
            <p class="eyebrow">SALE COMPLETE</p><h2 id="receipt-title" tabindex="-1" @ref="_receiptHeading">Thank you</h2>
            <div class="receipt-meta"><p>Receipt <strong>@_receipt.ReceiptNumber</strong></p><p>@_receipt.CreatedAtUtc.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.GetCultureInfo("en-ZA")) SAST</p></div>
            <div class="receipt-items">
                @foreach (var line in _receipt.Items)
                {
                    <div class="receipt-line">
                        <div class="receipt-item-details"><strong>@line.ProductName</strong><small>@line.Sku · @line.Quantity × @Money(line.UnitPrice)</small></div>
                        <strong>@Money(line.LineTotal)</strong>
                    </div>
                }
            </div>
            <div class="receipt-breakdown">
                <div><span>Subtotal</span><span>@Money(_receipt.Subtotal)</span></div>
                <div><span>Discount</span><span>@Money(_receipt.Discount)</span></div>
                <div class="receipt-total"><span>Total paid</span><strong>@Money(_receipt.GrandTotal)</strong></div>
                <div><span>Payment method</span><span>@_receipt.PaymentMethod</span></div>
                <div><span>Amount tendered</span><span>@Money(_receipt.AmountTendered)</span></div>
                <div><span>Change</span><strong>@Money(_receipt.ChangeAmount)</strong></div>
            </div>
            <button class="button button-primary" @onclick="PrintReceipt">Print receipt</button>
            <button class="button button-quiet" @onclick="StartNextSale">Start next sale</button>
        </section>
    }
    else
    {
        <div class="sales-grid @(_rushMode ? "rush-mode" : "")">
            <section class="panel">
                <div class="panel-heading"><h2>Products</h2><div class="panel-actions"><span class="count-pill">@_products.Count available</span><button class="button button-quiet" @onclick="ToggleRushMode" aria-pressed="@_rushMode">@(_rushMode ? "Exit Rush mode" : "Rush mode")</button><button class="button button-quiet" @onclick="LoadProducts" disabled="@_loading">Refresh stock</button></div></div>
                <input class="form-control" placeholder="Search product or SKU" @bind="_search" @bind:event="oninput" aria-label="Search products" />
                @if (_loading) { <p class="muted" role="status">Loading products…</p> }
                else if (_catalogueLoadFailed)
                {
                    <div class="inline-alert" role="alert">The product catalogue could not be loaded. Check your connection and retry.</div>
                    <button class="button button-quiet" @onclick="LoadProducts" disabled="@_loading">Retry loading products</button>
                }
                else if (_products.Count == 0) { <div class="empty-state"><strong>No active products</strong><p class="muted">Add or activate products before starting a sale.</p></div> }
                else if (!FilteredProducts.Any()) { <p class="muted" role="status">No products match “@_search”. Try another name or SKU.</p> }
                <div class="product-picker">
                    @foreach (var product in FilteredProducts)
                    {
                        <button class="product-pick" @onclick="() => Add(product)" disabled="@(product.Available <= 0)">
                            <span class="product-initial" style="@InitialStyle(product.Category)">@Initial(product.Name)</span>
                            <span class="product-pick-copy"><strong>@product.Name</strong><small>@product.Sku</small></span>
                            <span class="product-pick-price">@Money(product.UnitPrice)</span>
                            <span class="product-stock">@product.Available left</span>
                        </button>
                    }
                </div>
            </section>
            <section class="panel cart-panel">
                <div class="panel-heading"><h2>Basket</h2><span class="count-pill">@_cart.Sum(x => x.Quantity) items</span></div>
                @if (_cart.Count == 0) { <div class="empty-state"><strong>Your basket is empty</strong><p class="muted">Select products to start a sale.</p></div> }
                @if (!string.IsNullOrWhiteSpace(_basketNotice)) { <div class="inline-alert" role="status">@_basketNotice</div> }
                @if (CartHasUnavailableProduct) { <div class="inline-alert" role="alert">Stock availability changed. Reduce or remove the affected quantities before proceeding to payment.</div> }
                else
                {
                    @foreach (var line in _cart)
                    {
                        <div class="cart-line"><div><strong>@line.Product.Name</strong><small>@Money(line.Product.UnitPrice) each</small></div><div class="quantity-control"><button aria-label="Decrease @line.Product.Name" @onclick="() => Change(line, -1)">−</button><strong>@line.Quantity</strong><button aria-label="Increase @line.Product.Name" @onclick="() => Change(line, 1)">+</button></div><strong>@Money(line.Product.UnitPrice * line.Quantity)</strong></div>
                    }
                }
                <div class="cart-total" aria-live="polite" aria-atomic="true"><span>Total due</span><strong>@Money(Total)</strong></div>
                <button @ref="_checkoutButton" class="button button-primary checkout-button" @onclick="OpenPaymentModal" disabled="@(_busy || _cart.Count == 0 || CartHasUnavailableProduct)">Proceed to payment</button>
                <p class="muted small-note">Stock is deducted by the API using first-expiry-first-out batch allocation.</p>
            </section>
        </div>
    }
    @if (_showPaymentModal)
    {
        <div class="payment-modal-backdrop">
            <section class="payment-modal" role="dialog" aria-modal="true" aria-labelledby="payment-modal-title">
                <div class="panel-heading">
                    <div><p class="eyebrow">CHECKOUT · PAYMENT</p><h2 id="payment-modal-title">Take payment</h2></div>
                    <button class="button button-quiet" type="button" @onclick="ClosePaymentModal" disabled="@_busy">Close</button>
                </div>
                <div class="summary-line"><span>Total due</span><strong>@Money(Total)</strong></div>
                @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error</div> }
                @if (_cashShiftRequired) { <div class="inline-alert" role="alert">Open your cash shift before continuing. <a href="/cash-shift">Open cash shift</a></div> }
                @if (_checkingCashShift && _paymentMethod == "Cash") { <p class="muted" role="status">Checking cash-shift status…</p> }
                @if (_cashShiftLoadFailed && _paymentMethod == "Cash")
                {
                    <div class="inline-alert" role="alert">Cash-shift status could not be verified. Refresh before accepting cash. <button class="link-button" @onclick="LoadCashShift">Retry status check</button></div>
                }
                else if (_paymentMethod == "Cash" && !_checkingCashShift && _cashShift is null)
                {
                    <div class="inline-alert" role="status">Open a cash shift before accepting cash. <a href="/cash-shift">Open cash shift</a></div>
                }
                <label for="payment-method">Payment method</label>
                <select id="payment-method" class="form-control" @bind="_paymentMethod" @bind:after="OnPaymentMethodChanged"><option value="Cash">Cash</option><option value="Card">Card</option></select>
                @if (_paymentMethod == "Cash")
                {
                    <label for="tendered">Cash received (ZAR)</label>
                    <input id="tendered" class="form-control" type="number" min="0" step="0.01" @bind="_tendered" @bind:after="ResetIdempotencyKey" />
                    <div class="change-preview" role="status" aria-live="polite" aria-atomic="true"><span>Change due</span><strong class="@(ChangeDue < 0 ? "text-danger" : "")">@Money(Math.Max(0, ChangeDue))</strong></div>
                    @if (ChangeDue < 0) { <p class="field-error">Cash received is less than the total due.</p> }
                }
                else
                {
                    <label class="card-confirmation"><input type="checkbox" @bind="_cardPaymentConfirmed" @bind:after="ResetIdempotencyKey" /> I confirm the card terminal approved this payment.</label>
                    <p id="payment-modal-help" class="muted small-note">ShopPulse records the payment confirmation; it does not process card details or replace your bank terminal.</p>
                }
                <button class="button button-primary checkout-button" @onclick="CompleteSale" disabled="@(_busy || _checkingCashShift || CartHasUnavailableProduct || (_paymentMethod == "Cash" && (_cashShiftLoadFailed || ChangeDue < 0 || _cashShift is null)) || (_paymentMethod == "Card" && !_cardPaymentConfirmed))">@(_busy ? "Processing…" : "Complete sale")</button>
            </section>
        </div>
    }
</main>

@code {
    private List<ProductOption> _products = [];
    private List<CartLine> _cart = [];
    private string _search = "", _paymentMethod = "Cash";
    private decimal _tendered;
    private bool _loading = true, _busy, _cashShiftRequired, _checkingCashShift = true, _rushMode, _catalogueLoadFailed, _cashShiftLoadFailed, _modalFocusActive, _restoreFocusAfterModal, _focusReceiptAfterRender;
    private string? _error, _basketNotice;
    private SaleResult? _receipt;
    private ElementReference _paymentDialog, _checkoutButton, _receiptHeading;
    private bool CartHasUnavailableProduct => _cart.Any(line => !_products.Any(p => p.Id == line.Product.Id) || _products.First(p => p.Id == line.Product.Id).Available < line.Quantity);
    // Retain the same key when a network response is lost so a retry cannot create a duplicate sale.
    private string? _idempotencyKey;
    private bool _cardPaymentConfirmed, _showPaymentModal;
    private CashShiftInfo? _cashShift;
    private decimal Total => _cart.Sum(x => x.Product.UnitPrice * x.Quantity);
    private decimal ChangeDue => _tendered - Total;
    private IEnumerable<ProductOption> FilteredProducts => _products.Where(p => string.IsNullOrWhiteSpace(_search) || p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Sku.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showPaymentModal && !_modalFocusActive)
        {
            _modalFocusActive = true;
            await JS.InvokeVoidAsync("shopPulseModal.activate", _paymentDialog);
        }
        else if (!_showPaymentModal && _modalFocusActive)
        {
            await JS.InvokeVoidAsync("shopPulseModal.deactivate");
            _modalFocusActive = false;
            if (_restoreFocusAfterModal && _receipt is null) await _checkoutButton.FocusAsync();
            _restoreFocusAfterModal = false;
        }
        if (_focusReceiptAfterRender && _receipt is not null)
        {
            _focusReceiptAfterRender = false;
            await _receiptHeading.FocusAsync();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated && !await Session.RestoreAsync()) { Nav.NavigateTo("/"); return; }
        await Task.WhenAll(LoadProducts(), LoadCashShift());
    }
    private async Task LoadCashShift()
    {
        _checkingCashShift = true;
        try { _cashShift = await Http.GetFromJsonAsync<CashShiftInfo>("api/cash-shifts/current"); _cashShiftLoadFailed = false; if (_cashShift is not null) _cashShiftRequired = false; }
        catch (Exception ex) when (ex is HttpRequestException or JsonException) { _cashShift = null; _cashShiftLoadFailed = true; _error = "Could not verify your cash shift. Refresh the status before accepting cash."; }
        finally { _checkingCashShift = false; }
    }
    private async Task LoadProducts()
    {
        _loading = true;
        try
        {
            var refreshed = await Http.GetFromJsonAsync<List<ProductOption>>("api/products") ?? [];
            var changed = false;
            foreach (var line in _cart)
            {
                var latest = refreshed.FirstOrDefault(p => p.Id == line.Product.Id);
                if (latest is not null)
                {
                    if (latest.UnitPrice != line.Product.UnitPrice || latest.Available != line.Product.Available) changed = true;
                    line.Product = latest;
                }
            }
            _products = refreshed;
            _catalogueLoadFailed = false;
            if (changed) _basketNotice = "Product prices or available quantities changed. Review the updated basket before payment.";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException) { _catalogueLoadFailed = true; _error = "The catalogue could not be reached. Try again."; }
        finally { _loading = false; }
    }
    private void Add(ProductOption product)
    {
        if (product.Available <= 0) return;
        var line = _cart.FirstOrDefault(x => x.Product.Id == product.Id);
        if (line is null) _cart.Add(new CartLine(product)); else if (line.Quantity < product.Available) line.Quantity++;
        _error = null;
        ResetIdempotencyKey();
    }
    private void Change(CartLine line, int amount)
    {
        line.Quantity = Math.Max(0, Math.Min(line.Product.Available, line.Quantity + amount));
        if (line.Quantity == 0) _cart.Remove(line);
        ResetIdempotencyKey();
    }
    private async Task CompleteSale()
    {
        if (_cart.Count == 0) { _error = "Add at least one product to the basket."; return; }
        if (CartHasUnavailableProduct) { _error = "Refresh stock and correct the affected basket quantities before payment."; return; }
        if (_paymentMethod == "Cash" && _tendered < Total) { _error = "Enter enough cash to cover the sale."; return; }
        if (_paymentMethod == "Card" && !_cardPaymentConfirmed) { _error = "Confirm the payment was approved on your card terminal."; return; }
        _busy = true; _error = null; _cashShiftRequired = false;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, "api/sales")
            {
                Content = JsonContent.Create(new { items = _cart.Select(x => new { productId = x.Product.Id, quantity = x.Quantity, expectedUnitPrice = x.Product.UnitPrice }), paymentMethod = _paymentMethod, amountTendered = _paymentMethod == "Cash" ? _tendered : Total, cardPaymentConfirmed = _paymentMethod == "Card" && _cardPaymentConfirmed })
            };
            _idempotencyKey ??= Guid.NewGuid().ToString("N");
            request.Headers.Add("Idempotency-Key", _idempotencyKey);
            using var response = await Http.SendAsync(request);
            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                var problem = await response.Content.ReadFromJsonAsync<JsonDocument>();
                var code = problem?.RootElement.TryGetProperty("code", out var codeValue) == true ? codeValue.GetString() : null;
                _cashShiftRequired = code == "CASH_SHIFT_REQUIRED";
                if (_cashShiftRequired) await LoadCashShift();
                _error = problem?.RootElement.TryGetProperty("message", out var m) == true ? m.GetString() : "Stock changed while you were checking out. Review the basket.";
                if (code is "PRICE_CHANGED" or "INSUFFICIENT_STOCK" or "CONCURRENCY_CONFLICT")
                {
                    await LoadProducts();
                    foreach (var line in _cart)
                    {
                        var refreshed = _products.FirstOrDefault(x => x.Id == line.Product.Id);
                        if (refreshed is not null) line.Product = refreshed;
                    }
                    ResetIdempotencyKey();
                }
                Toast.ShowError(_error ?? "The checkout could not be completed.");
                return;
            }
            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _error = await ApiErrorFormatter.FormatAsync(response, "Check the payment details and try again.");
                return;
            }
            if (!response.IsSuccessStatusCode)
            {
                var message = await ApiErrorFormatter.FormatAsync(response, "The sale could not be completed. Please try again.");
                if ((int)response.StatusCode >= 500) Toast.ShowError(message);
                else _error = message;
                return;
            }
            _receipt = await response.Content.ReadFromJsonAsync<SaleResult>() ?? throw new JsonException("The API returned an empty receipt.");
            _showPaymentModal = false;
            _idempotencyKey = null;
            _focusReceiptAfterRender = true;
            Toast.ShowSuccess($"Sale completed. Receipt {_receipt.ReceiptNumber}.");
        }
        catch (HttpRequestException) { _error = "The service could not be reached. The sale may not have completed. Retry using this same checkout screen so the idempotency key can prevent a duplicate."; }
        catch (JsonException) { _error = "The sale response could not be read. Do not start another sale; retry this checkout so the server can return the original receipt safely."; }
        finally { _busy = false; }
    }
    private void ToggleRushMode() => _rushMode = !_rushMode;
    private void OpenPaymentModal() { _error = null; _cashShiftRequired = false; _cardPaymentConfirmed = false; ResetIdempotencyKey(); _showPaymentModal = true; }
    private void ClosePaymentModal() { if (!_busy) { _showPaymentModal = false; _cardPaymentConfirmed = false; _restoreFocusAfterModal = true; ResetIdempotencyKey(); } }
    private void HandlePaymentModalKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape" && !_busy) ClosePaymentModal(); }
    private void ResetIdempotencyKey() => _idempotencyKey = null;
    private void OnPaymentMethodChanged() { ResetIdempotencyKey(); _cardPaymentConfirmed = false; }
    private void StartNextSale() { _receipt = null; _cart.Clear(); _tendered = 0; _search = ""; _error = null; _basketNotice = null; _cardPaymentConfirmed = false; _showPaymentModal = false; ResetIdempotencyKey(); _ = LoadProducts(); }
    private async Task PrintReceipt() => await JS.InvokeVoidAsync("window.print");
    private static string Money(decimal amount) => amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"));
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name[..1].ToUpperInvariant();
    private static string InitialStyle(string? category) => category?.ToLowerInvariant() switch { "bakery" or "bread" => "background:#f4e6d2;color:#80532a", "dairy" => "background:#e3eff8;color:#245a80", "beverages" => "background:#e6f2e9;color:#27643b", _ => "background:#edf0f5;color:#435064" };
    private sealed class CashShiftInfo { public Guid Id { get; set; } public decimal OpeningFloat { get; set; } public DateTimeOffset OpenedAtUtc { get; set; } }
    private sealed class ProductOption { public Guid Id { get; set; } public string Name { get; set; } = ""; public string Sku { get; set; } = ""; public string? Category { get; set; } public decimal UnitPrice { get; set; } public int Available { get; set; } }
    private sealed class CartLine(ProductOption product) { public ProductOption Product { get; set; } = product; public int Quantity { get; set; } = 1; }
    private sealed record SaleResult(Guid Id, string ReceiptNumber, decimal Subtotal, decimal Discount, decimal GrandTotal, string PaymentMethod, decimal AmountTendered, decimal ChangeAmount, DateTimeOffset CreatedAtUtc, List<SaleLineResult> Items);
    private sealed record SaleLineResult(string ProductName, string Sku, int Quantity, decimal UnitPrice, decimal LineTotal);
}