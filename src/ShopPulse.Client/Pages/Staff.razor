@page "/staff"
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Nav
@inject ShopPulse.Client.ToastService Toast

<PageTitle>Manage staff | ShopPulse</PageTitle>
<main class="feature-page">
    <header class="feature-header"><a href="/" class="brand-lockup"><span class="brand-mark">S</span><span><strong>ShopPulse</strong><small>RETAIL WORKSPACE</small></span></a><span class="role-chip">Staff access</span></header>
    <ShopPulse.Client.Shared.WorkspaceNav />
    <section class="feature-heading"><p class="eyebrow">TEAM · OWNER</p><h1>Manage staff</h1><p class="muted">Create operator accounts and assign specific product, receiving, waste and refund permissions.</p></section>
    @if (_forbidden) { <div class="inline-alert" role="alert">Only the store owner can manage staff accounts.</div> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error</div> }
        <section class="panel form-panel">
            <div class="panel-heading"><h2>Add an operator</h2></div>
            <EditForm Model="_newStaff" OnValidSubmit="Create">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="field-group"><label for="staff-name">Full name</label><InputText id="staff-name" class="form-control" @bind-Value="_newStaff.DisplayName" maxlength="120" /><ValidationMessage For="@(() => _newStaff.DisplayName)" /></div>
                    <div class="field-group"><label for="staff-email">Email address</label><InputText id="staff-email" class="form-control" type="email" @bind-Value="_newStaff.Email" autocomplete="off" /><ValidationMessage For="@(() => _newStaff.Email)" /></div>
                    <div class="field-group"><label for="staff-password">Initial password</label><InputText id="staff-password" class="form-control" type="password" @bind-Value="_newStaff.Password" autocomplete="new-password" /><ValidationMessage For="@(() => _newStaff.Password)" /></div>
                    <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_newStaff.CanAdjustStock" /> Allow this operator to record stock waste</label></div>
                    <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_newStaff.CanRefundSales" /> Allow this operator to refund sales</label></div>
                    <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_newStaff.CanManageProducts" /> Allow this operator to manage products</label></div>
                    <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_newStaff.CanReceiveStock" /> Allow this operator to receive stock</label></div>
                    <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_newStaff.CanManageProducts" /> Allow this operator to manage products and prices</label></div>
                    <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_newStaff.CanReceiveStock" /> Allow this operator to receive stock</label></div>
                </div>
                <p class="muted small-note">Give the initial password to the operator securely. Password reset and invitation email are not yet integrated.</p>
                <button class="button button-primary" type="submit" disabled="@_busy">@(_busy ? "Creating…" : "Create operator")</button>
            </EditForm>
        </section>

        @if (_editing is not null)
        {
            <section class="panel form-panel">
                <div class="panel-heading"><h2>Edit @_editing.DisplayName</h2><button class="button button-quiet" @onclick="CancelEdit">Cancel</button></div>
                <EditForm Model="_editing" OnValidSubmit="Update">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                        <div class="field-group full"><label for="edit-name">Display name</label><InputText id="edit-name" class="form-control" @bind-Value="_editing.DisplayName" maxlength="120" /><ValidationMessage For="@(() => _editing.DisplayName)" /></div>
                        <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_editing.IsActive" /> Account active</label></div>
                        <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_editing.CanAdjustStock" /> Can record stock waste</label></div>
                        <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_editing.CanRefundSales" /> Can refund sales</label></div>
                        <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_editing.CanManageProducts" /> Can manage products</label></div>
                        <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_editing.CanReceiveStock" /> Can receive stock</label></div>
                        <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_editing.CanManageProducts" /> Can manage products and prices</label></div>
                        <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_editing.CanReceiveStock" /> Can receive stock</label></div>
                    </div>
                    <button class="button button-primary" type="submit" disabled="@_busy">Save staff access</button>
                </EditForm>
            </section>
        }

        <section class="panel products-panel">
            <div class="panel-heading"><h2>Store team</h2><button class="button button-quiet" @onclick="Load" disabled="@_busy">Refresh</button></div>
            @if (_loading) { <p class="muted">Loading staff…</p> }
            else if (_staff.Count == 0) { <p class="muted">No staff accounts found.</p> }
            else
            {
                <div class="table-wrap"><table>
                    <thead><tr><th>TEAM MEMBER</th><th>ROLE</th><th>ACCESS</th><th>STATUS</th><th>ACTIONS</th></tr></thead>
                    <tbody>
                    @foreach (var person in _staff)
                    {
                        <tr>
                            <td><strong>@person.DisplayName</strong><small class="table-subtext">@person.Email</small></td>
                            <td>@person.Role</td>
                            <td>@AccessSummary(person)</td>
                            <td><span class="stock-status @(person.IsActive ? "ok" : "low")">@(person.IsActive ? "Active" : "Inactive")</span></td>
                            <td>@if (person.Role != "Owner") { <button class="button button-quiet" @onclick="() => Edit(person)">Edit access</button> } else { <span class="muted">Protected</span> }</td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </section>
    }
</main>

@code {
    private List<StaffRow> _staff = [];
    private NewStaffForm _newStaff = new();
    private EditStaffForm? _editing;
    private bool _loading = true, _busy, _forbidden;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated && !await Session.RestoreAsync()) { Nav.NavigateTo("/"); return; }
        if (Session.User?.Role != "Owner") { _forbidden = true; return; }
        await Load();
    }

    private async Task Load()
    {
        _loading = true; _error = null;
        try { _staff = await Http.GetFromJsonAsync<List<StaffRow>>("api/staff") ?? []; }
        catch (HttpRequestException) { _error = "The staff list could not be loaded."; }
        finally { _loading = false; }
    }

    private async Task Create()
    {
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/staff", new { displayName = _newStaff.DisplayName, email = _newStaff.Email, password = _newStaff.Password, canAdjustStock = _newStaff.CanAdjustStock, canRefundSales = _newStaff.CanRefundSales, canManageProducts = _newStaff.CanManageProducts, canReceiveStock = _newStaff.CanReceiveStock });
            if (!response.IsSuccessStatusCode)
            {
                var message = await ApiErrorFormatter.FormatAsync(response, "The operator account could not be created.");
                if ((int)response.StatusCode >= 500) Toast.ShowError(message); else _error = message;
                return;
            }
            _newStaff = new();
            Toast.ShowSuccess("Operator account created.");
            await Load();
        }
        catch (HttpRequestException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }

    private void Edit(StaffRow person)
    {
        _editing = new EditStaffForm { Id = person.Id, DisplayName = person.DisplayName, IsActive = person.IsActive, CanAdjustStock = person.CanAdjustStock, CanRefundSales = person.CanRefundSales, CanManageProducts = person.CanManageProducts, CanReceiveStock = person.CanReceiveStock };
        _error = null;
    }
    private void CancelEdit() => _editing = null;

    private async Task Update()
    {
        if (_editing is null) return;
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/staff/{_editing.Id}", new { displayName = _editing.DisplayName, isActive = _editing.IsActive, canAdjustStock = _editing.CanAdjustStock, canRefundSales = _editing.CanRefundSales, canManageProducts = _editing.CanManageProducts, canReceiveStock = _editing.CanReceiveStock });
            if (!response.IsSuccessStatusCode)
            {
                var message = await ApiErrorFormatter.FormatAsync(response, "Staff access could not be updated.");
                if ((int)response.StatusCode >= 500) Toast.ShowError(message); else _error = message;
                return;
            }
            _editing = null;
            Toast.ShowSuccess("Staff access updated.");
            await Load();
        }
        catch (HttpRequestException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }

    private static string AccessSummary(StaffRow person)
    {
        if (person.Role == "Owner") return "Full owner access";
        var permissions = new List<string>();
        if (person.CanAdjustStock) permissions.Add("Stock waste");
        if (person.CanRefundSales) permissions.Add("Refunds");
        if (person.CanManageProducts) permissions.Add("Product management");
        if (person.CanReceiveStock) permissions.Add("Stock receiving");
        return permissions.Count == 0 ? "Sales only" : string.Join(" · ", permissions);
    }

    private sealed class NewStaffForm
    {
        [Required, StringLength(120, MinimumLength = 2)] public string DisplayName { get; set; } = "";
        [Required, EmailAddress, StringLength(256)] public string Email { get; set; } = "";
        [Required, StringLength(128, MinimumLength = 12)] public string Password { get; set; } = "";
        public bool CanAdjustStock { get; set; }
        public bool CanRefundSales { get; set; }
        public bool CanManageProducts { get; set; }
        public bool CanReceiveStock { get; set; }
    }
    private sealed class EditStaffForm
    {
        public Guid Id { get; set; }
        [Required, StringLength(120, MinimumLength = 2)] public string DisplayName { get; set; } = "";
        public bool IsActive { get; set; }
        public bool CanAdjustStock { get; set; }
        public bool CanRefundSales { get; set; }
        public bool CanManageProducts { get; set; }
        public bool CanReceiveStock { get; set; }
    }
    private sealed class StaffRow
    {
        public Guid Id { get; set; } public string DisplayName { get; set; } = ""; public string Email { get; set; } = "";
        public string Role { get; set; } = ""; public bool IsActive { get; set; } public bool CanAdjustStock { get; set; } public bool CanRefundSales { get; set; } public bool CanManageProducts { get; set; } public bool CanReceiveStock { get; set; }
    }
}
