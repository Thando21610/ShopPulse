@page "/stock/receive"
@using System.Text.Json
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Nav
@inject ShopPulse.Client.ToastService Toast

<PageTitle>Receive stock | ShopPulse</PageTitle>
<main class="feature-page">
    <ShopPulse.Client.Shared.WorkspaceHeader />
    <ShopPulse.Client.Shared.WorkspaceNav />
    <section class="feature-heading"><p class="eyebrow">INVENTORY · INBOUND</p><h1>Receive stock</h1><p class="muted">Record a delivery and create a traceable stock batch.</p></section>
    @if (_forbidden) { <div class="inline-alert" role="alert">Your account is not authorised to receive stock. Ask the owner to grant stock-receiving permission.</div> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error</div> }
        @if (_loadingProducts)
        {
            <section class="panel empty-state" role="status">Loading products…</section>
        }
        else if (_productLoadFailed)
        {
            <section class="panel empty-state">
                <strong>Products could not be loaded</strong>
                <p class="muted">Check your connection and try again. No stock has been changed.</p>
                <button class="button button-quiet" @onclick="LoadProducts" disabled="@_loadingProducts">Retry</button>
            </section>
        }
        else if (_products.Count == 0)
        {
            <section class="panel empty-state">
                <strong>No active products available</strong>
                <p class="muted">Stock cannot be received until at least one active product exists. Ask the store owner to add a product first.</p>
                @if (Session.User?.Role == "Owner" || Session.User?.CanManageProducts == true)
                {
                    <a class="button button-quiet" href="/products/manage">Manage products</a>
                }
            </section>
        }
        else
        {
        <section class="panel form-panel">
            <EditForm EditContext="_editContext" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="field-group full"><label for="product">Product</label><InputSelect id="product" class="form-control" @bind-Value="_form.ProductId"><option value="">Choose a product</option>@foreach(var p in _products){<option value="@p.Id">@p.Name (@p.Sku)@(p.HasExpiry ? " · expiry tracked" : "")</option>}</InputSelect><ValidationMessage For="@(() => _form.ProductId)" /></div>
                    <div class="field-group"><label for="quantity">Quantity received</label><InputNumber id="quantity" class="form-control" @bind-Value="_form.Quantity" min="1" /><ValidationMessage For="@(() => _form.Quantity)" /></div>
                    <div class="field-group"><label for="cost">Unit cost (ZAR)</label><InputNumber id="cost" class="form-control" @bind-Value="_form.UnitCost" min="0" step="0.01" /><ValidationMessage For="@(() => _form.UnitCost)" /></div>
                    <div class="field-group"><label for="expiry">Expiry date @(_products.FirstOrDefault(x => x.Id == _form.ProductId)?.HasExpiry == true ? "(required)" : "(optional)")</label><InputDate id="expiry" class="form-control" @bind-Value="_form.ExpiryDate" /><ValidationMessage For="@(() => _form.ExpiryDate)" /></div>
                    <div class="field-group"><label for="supplier">Supplier (optional)</label><InputText id="supplier" class="form-control" @bind-Value="_form.Supplier" maxlength="160" /><ValidationMessage For="@(() => _form.Supplier)" /></div>
                    <div class="field-group full"><label for="batch">Batch reference (optional)</label><InputText id="batch" class="form-control" @bind-Value="_form.BatchReference" maxlength="80" /><ValidationMessage For="@(() => _form.BatchReference)" /></div>
                </div>
                <p class="muted small-note">Server validation is authoritative. Stock is added only after the receipt is saved.</p>
                <button class="button button-primary" type="submit" disabled="@_busy">@(_busy ? "Saving receipt…" : "Receive stock")</button>
            </EditForm>
        </section>
        }
    }
    @if (_success) { <div class="toast-inline" role="status">Stock received successfully.</div> }
</main>

@code {
    private List<ProductOption> _products = [];
    private ReceiveForm _form = new();
    private EditContext _editContext = default!;
    private bool _busy, _forbidden, _success, _loadingProducts = true, _productLoadFailed;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_form);
        _editContext.OnFieldChanged += (_, _) => ApiErrorFormatter.ClearServerValidationErrors(_editContext);
        if (!Session.IsAuthenticated && !await Session.RestoreAsync()) { Nav.NavigateTo("/"); return; }
        if (Session.User?.Role != "Owner" && Session.User?.CanReceiveStock != true) { _forbidden = true; return; }
        await LoadProducts();
    }
    private async Task LoadProducts()
    {
        _loadingProducts = true;
        _productLoadFailed = false;
        _error = null;
        try { _products = await Http.GetFromJsonAsync<List<ProductOption>>("api/products") ?? []; }
        catch (Exception ex) when (ex is HttpRequestException or JsonException) { _productLoadFailed = true; _error = "Could not load products. Try again."; }
        finally { _loadingProducts = false; }
    }
    private async Task Submit()
    {
        ApiErrorFormatter.ClearServerValidationErrors(_editContext);
        _busy = true; _error = null; _success = false;
        try
        {
            var selectedProduct = _products.FirstOrDefault(x => x.Id == _form.ProductId);
            if (selectedProduct is null) { ApiErrorFormatter.SetFieldValidationError(_editContext, nameof(ReceiveForm.ProductId), "Choose a valid product."); return; }
            if (selectedProduct.HasExpiry && !_form.ExpiryDate.HasValue) { ApiErrorFormatter.SetFieldValidationError(_editContext, nameof(ReceiveForm.ExpiryDate), "An expiry date is required for this product."); return; }
            if (_form.ExpiryDate.HasValue && _form.ExpiryDate.Value.Date < DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(2)).Date) { ApiErrorFormatter.SetFieldValidationError(_editContext, nameof(ReceiveForm.ExpiryDate), "Expiry date cannot be in the past."); return; }
            var payload = new { productId = _form.ProductId ?? Guid.Empty, quantity = _form.Quantity, unitCost = _form.UnitCost, expiryDate = _form.ExpiryDate?.ToString("yyyy-MM-dd"), supplier = _form.Supplier, batchReference = _form.BatchReference };
            using var response = await Http.PostAsJsonAsync("api/stock/receipts", payload);
            if (response.IsSuccessStatusCode) { _form = new(); _editContext = new EditContext(_form); _editContext.OnFieldChanged += (_, _) => ApiErrorFormatter.ClearServerValidationErrors(_editContext); _success = true; Toast.ShowSuccess("Stock received successfully."); return; }
            if (response.StatusCode == System.Net.HttpStatusCode.BadRequest
                && await ApiErrorFormatter.ApplyValidationErrorsAsync(response, _editContext))
                return;
            var message = await ApiErrorFormatter.FormatAsync(response, "The stock receipt could not be saved.");
            if ((int)response.StatusCode >= 500) Toast.ShowError(message); else _error = message;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }
    private sealed class ReceiveForm
    {
        [Required(ErrorMessage = "Choose a product.")]
        public Guid? ProductId { get; set; }
        [Range(1, 100000, ErrorMessage = "Quantity must be at least 1.")]
        public int Quantity { get; set; } = 1;
        [Range(typeof(decimal), "0", "10000000", ErrorMessage = "Unit cost must be zero or greater.")]
        public decimal UnitCost { get; set; }
        public DateTime? ExpiryDate { get; set; }
        [StringLength(160)] public string? Supplier { get; set; }
        [StringLength(80)] public string? BatchReference { get; set; }
    }
    private sealed class ProductOption { public Guid Id { get; set; } public string Name { get; set; } = ""; public string Sku { get; set; } = ""; public bool HasExpiry { get; set; } }
}