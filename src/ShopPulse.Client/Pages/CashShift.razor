@page "/cash-shift"
@using System.Net.Http.Json
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Nav
@inject ShopPulse.Client.ToastService Toast

<PageTitle>Cash shift | ShopPulse</PageTitle>
<main class="feature-page">
    <header class="feature-header"><a href="/" class="brand-lockup"><span class="brand-mark">S</span><span><strong>ShopPulse</strong><small>RETAIL WORKSPACE</small></span></a><span class="role-chip">Cash control</span></header>
    <ShopPulse.Client.Shared.WorkspaceNav />
    <section class="feature-heading"><p class="eyebrow">DAILY OPERATIONS · CASH</p><h1>Cash shift</h1><p class="muted">Record opening float, track cash sales and reconcile the drawer at close.</p></section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error</div> }

    @if (_result is not null)
    {
        <section class="panel form-panel">
            <p class="eyebrow">SHIFT CLOSED</p><h2>Cash reconciliation</h2>
            <div class="summary-line"><span>Opening float</span><strong>@Money(_result.OpeningFloat)</strong></div>
            <div class="summary-line"><span>Expected cash</span><strong>@Money(_result.ExpectedCash)</strong></div>
            <div class="summary-line"><span>Actual cash counted</span><strong>@Money(_result.ActualCash)</strong></div>
            <div class="summary-line"><span>Variance</span><strong class="@(_result.Variance < 0 ? "text-danger" : "")">@Money(_result.Variance)</strong></div>
            <p class="muted">The shift has been closed and the variance recorded.</p>
            @if (IsOwner && _openShifts.Count > 0)
            {
                <button class="button button-primary" @onclick="ContinueReconciliation">Reconcile another open shift (@_openShifts.Count)</button>
            }
            else
            {
                <button class="button button-quiet" @onclick="ContinueReconciliation">Back to cash shifts</button>
            }
        </section>
    }
    else if (_shift is null)
    {
        <section class="panel form-panel">
            <h2>Open a cash shift</h2>
            <p class="muted">Start each operator's shift with the cash float in the drawer.</p>
            <label for="opening">Opening float (ZAR)</label>
            <input id="opening" class="form-control" type="number" min="0" step="0.01" @bind="_openingFloat" />
            <button class="button button-primary" @onclick="Open" disabled="@_busy">@(_busy ? "Opening…" : "Open shift")</button>
        </section>
    }
    else
    {
        @if (IsOwner && Session.User is not null && !_openShifts.Any(x => x.OperatorUserId == Session.User.Id))
        {
            <section class="panel form-panel">
                <h2>Open your own cash shift</h2>
                <label for="owner-opening">Opening float (ZAR)</label>
                <input id="owner-opening" class="form-control" type="number" min="0" step="0.01" @bind="_openingFloat" />
                <button class="button button-primary" @onclick="Open" disabled="@_busy">@(_busy ? "Opening…" : "Open my shift")</button>
            </section>
        }
        <section class="panel form-panel">
            @if (IsOwner && _openShifts.Count > 1)
            {
                <label for="shift-select">Open staff shifts</label>
                <select id="shift-select" class="form-control" @bind="_selectedShiftId" @bind:after="SelectShift">
                    @foreach (var item in _openShifts)
                    {
                        <option value="@item.Id">@item.OperatorName · opened @item.OpenedAtUtc.ToLocalTime().ToString("dd MMM HH:mm")</option>
                    }
                </select>
            }
            <span class="badge-live">SHIFT OPEN</span>
            <h2>Cash drawer in progress</h2>
            @if (IsOwner) { <p class="muted">Reconciliation for @(string.IsNullOrWhiteSpace(_shift.OperatorName) ? "the selected staff member" : _shift.OperatorName).</p> }
            <div class="summary-line"><span>Opening float</span><strong>@Money(_shift.OpeningFloat)</strong></div>
            <div class="summary-line"><span>Opened</span><strong>@_shift.OpenedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</strong></div>
            <hr />
            <h3>Cash in / cash out</h3>
            <div class="form-grid">
                <div class="field-group"><label for="movement-direction">Movement</label><select id="movement-direction" class="form-control" @bind="_movement.Direction"><option value="In">Cash in</option><option value="Out">Cash out</option></select></div>
                <div class="field-group"><label for="movement-amount">Amount (ZAR)</label><input id="movement-amount" class="form-control" type="number" min="0.01" step="0.01" @bind="_movement.Amount" /></div>
                <div class="field-group full"><label for="movement-reason">Reason</label><input id="movement-reason" class="form-control" maxlength="500" @bind="_movement.Reason" /></div>
            </div>
            <button class="button button-quiet" @onclick="RecordMovement" disabled="@_busy">Record cash @_movement.Direction.ToLowerInvariant()</button>
            <h3>Cash movement history</h3>
            @if (_movements.Count == 0) { <p class="muted small-note">No cash-in or cash-out movements recorded.</p> }
            else
            {
                @foreach (var movement in _movements)
                {
                    <div class="summary-line"><span>@movement.CreatedAtUtc.ToLocalTime().ToString("dd MMM HH:mm") · @movement.Direction · @movement.Reason</span><strong>@(movement.Direction == "In" ? "+" : "−")@Money(movement.Amount)</strong></div>
                }
            }
            <hr />
            <h3>Close and reconcile</h3>
            <label for="actual">Actual cash counted (ZAR)</label>
            <input id="actual" class="form-control" type="number" min="0" step="0.01" @bind="_actualCash" />
            <label for="variance">Variance explanation (required if different)</label>
            <textarea id="variance" class="form-control" @bind="_varianceReason" maxlength="500"></textarea>
            <button class="button button-primary" @onclick="Close" disabled="@_busy">@(_busy ? "Closing…" : IsOwner ? "Close selected shift" : "Close my shift")</button>
        </section>
    }
</main>

@code {
    private ShiftInfo? _shift;
    private List<ShiftInfo> _openShifts = [];
    private Guid? _selectedShiftId;
    private CloseResult? _result;
    private List<CashMovementInfo> _movements = [];
    private CashMovementForm _movement = new();
    private decimal _openingFloat, _actualCash;
    private string? _varianceReason, _error;
    private bool _busy;
    private bool IsOwner => Session.User?.Role == "Owner";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated && !await Session.RestoreAsync()) { Nav.NavigateTo("/"); return; }
        await Load();
    }

    private async Task Load()
    {
        _error = null;
        try
        {
            if (IsOwner)
            {
                _openShifts = await Http.GetFromJsonAsync<List<ShiftInfo>>("api/cash-shifts/open") ?? [];
                if (!_openShifts.Any(x => x.Id == _selectedShiftId))
                    _selectedShiftId = _openShifts.FirstOrDefault()?.Id;
                await SelectShift();
            }
            else
            {
                _shift = await Http.GetFromJsonAsync<ShiftInfo>("api/cash-shifts/current");
                await LoadMovements();
            }
        }
        catch (HttpRequestException) { _error = "Could not load the current cash shifts. Check your session and try again."; }
    }

    private async Task SelectShift()
    {
        if (IsOwner)
        {
            _shift = _openShifts.FirstOrDefault(x => x.Id == _selectedShiftId);
            await LoadMovements();
        }
    }

    private async Task LoadMovements()
    {
        _movements = [];
        if (_shift is null) return;
        try { _movements = await Http.GetFromJsonAsync<List<CashMovementInfo>>($"api/cash-shifts/{_shift.Id}/movements") ?? []; }
        catch (HttpRequestException) { _error = "Cash movement history could not be loaded."; }
    }

    private async Task RecordMovement()
    {
        if (_shift is null) return;
        if (_movement.Amount <= 0 || string.IsNullOrWhiteSpace(_movement.Reason))
        {
            _error = "Enter a positive amount and a reason for the cash movement.";
            return;
        }
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/cash-shifts/movements", new
            {
                shiftId = _shift.Id, direction = _movement.Direction,
                amount = _movement.Amount, reason = _movement.Reason
            });
            if (!response.IsSuccessStatusCode)
            {
                _error = await ShopPulse.Client.ApiErrorFormatter.FormatAsync(response, "The cash movement could not be recorded.");
                return;
            }
            Toast.ShowSuccess($"Cash {_movement.Direction.ToLowerInvariant()} recorded.");
            _movement = new();
            await LoadMovements();
        }
        catch (HttpRequestException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }

    private async Task Open()
    {
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/cash-shifts/open", new { openingFloat = _openingFloat });
            if (!response.IsSuccessStatusCode)
            {
                _error = await ApiErrorFormatter.FormatAsync(response, "The cash shift could not be opened. Check that no shift is already open.");
                return;
            }
            _result = null;
            Toast.ShowSuccess("Cash shift opened.");
            await Load();
        }
        catch (HttpRequestException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }

    private async Task Close()
    {
        if (_shift is null) return;
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync("api/cash-shifts/close", new { shiftId = _shift.Id, actualCash = _actualCash, varianceReason = _varianceReason });
            if (!response.IsSuccessStatusCode)
            {
                _error = await ApiErrorFormatter.FormatAsync(response, "The cash shift could not be closed. Verify the counted cash and permissions.");
                return;
            }
            _result = await response.Content.ReadFromJsonAsync<CloseResult>();
            Toast.ShowSuccess("Cash shift closed and reconciled.");
            await Load();
        }
        catch (HttpRequestException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }

    private async Task ContinueReconciliation()
    {
        _result = null;
        _actualCash = 0;
        _varianceReason = null;
        await Load();
    }

    private static string Money(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"));

    private sealed class ShiftInfo
    {
        public Guid Id { get; set; }
        public Guid OperatorUserId { get; set; }
        public string? OperatorName { get; set; }
        public decimal OpeningFloat { get; set; }
        public DateTimeOffset OpenedAtUtc { get; set; }
    }

    private sealed class CashMovementForm
    {
        public string Direction { get; set; } = "In";
        public decimal Amount { get; set; }
        public string Reason { get; set; } = "";
    }

    private sealed class CashMovementInfo
    {
        public Guid Id { get; set; }
        public string Direction { get; set; } = "";
        public decimal Amount { get; set; }
        public string Reason { get; set; } = "";
        public DateTimeOffset CreatedAtUtc { get; set; }
    }

    private sealed class CloseResult
    {
        public decimal OpeningFloat { get; set; }
        public decimal ExpectedCash { get; set; }
        public decimal ActualCash { get; set; }
        public decimal Variance { get; set; }
    }
}
