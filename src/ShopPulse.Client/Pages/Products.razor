@page "/products/manage"
@using System.Text.Json
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject ShopPulse.Client.Auth.AuthSessionService Session
@inject NavigationManager Nav
@inject ShopPulse.Client.ToastService Toast

<PageTitle>Manage products | ShopPulse</PageTitle>
<main class="feature-page">
    <ShopPulse.Client.Shared.WorkspaceHeader />
    <ShopPulse.Client.Shared.WorkspaceNav />
    <section class="feature-heading"><p class="eyebrow">CATALOGUE · OWNER</p><h1>Manage products</h1><p class="muted">Create and maintain product details, selling prices and low-stock thresholds.</p></section>
    @if (_forbidden) { <div class="inline-alert" role="alert">Your account does not have permission to manage products. Ask the owner to grant access.</div> }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="inline-alert" role="alert">@_error</div> }
        <div class="management-grid">
        <section class="panel form-panel">
            <div class="panel-heading"><h2>@(_editingId.HasValue ? "Edit product" : "Add a product")</h2>@if (_editingId.HasValue) { <button class="button button-quiet" @onclick="ResetForm">Cancel edit</button> }</div>
            <EditForm EditContext="_editContext" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="form-grid">
                    <div class="field-group"><label for="sku">SKU</label><InputText id="sku" class="form-control" @bind-Value="_form.Sku" maxlength="64" /><ValidationMessage For="@(() => _form.Sku)" /></div>
                    <div class="field-group"><label for="name">Product name</label><InputText id="name" class="form-control" @bind-Value="_form.Name" maxlength="200" /><ValidationMessage For="@(() => _form.Name)" /></div>
                    <div class="field-group"><label for="category">Category</label><InputText id="category" class="form-control" @bind-Value="_form.Category" maxlength="80" /></div>
                    <div class="field-group"><label for="price">Selling price (ZAR)</label><InputNumber id="price" class="form-control" @bind-Value="_form.UnitPrice" min="0" step="0.01" /><ValidationMessage For="@(() => _form.UnitPrice)" /></div>
                    <div class="field-group"><label for="minimum">Low-stock threshold</label><InputNumber id="minimum" class="form-control" @bind-Value="_form.MinimumStockLevel" min="0" /><ValidationMessage For="@(() => _form.MinimumStockLevel)" /></div>
                    <div class="field-group checkbox-field"><label><InputCheckbox @bind-Value="_form.HasExpiry" /> This product has an expiry date</label></div>
                </div>
                <button class="button button-primary" type="submit" disabled="@_busy">@(_busy ? "Saving…" : _editingId.HasValue ? "Save changes" : "Add product")</button>
            </EditForm>
        </section>
        <section class="panel products-panel">
            <div class="panel-heading"><h2>Product list</h2><button class="button button-quiet" @onclick="Load" disabled="@_busy">Refresh</button></div>
            @if (_loading) { <p class="muted">Loading products…</p> }
            else if (_products.Count == 0) { <p class="muted">No products have been created yet.</p> }
            else
            {
                <div class="table-wrap"><table>
                    <thead><tr><th>PRODUCT</th><th>SKU</th><th>AVAILABLE</th><th>PRICE (ZAR)</th><th>STATUS</th><th>ACTIONS</th></tr></thead>
                    <tbody>
                    @foreach (var item in _products)
                    {
                        <tr>
                            <td><strong>@item.Name</strong><small class="table-subtext">@item.Category</small></td>
                            <td>@item.Sku</td><td>@item.Available</td><td>@Money(item.UnitPrice)</td>
                            <td><span class="stock-status @(item.IsActive ? "ok" : "low")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                            <td><div class="table-actions"><button class="button button-quiet" @onclick="() => Edit(item)">Edit</button>@if (item.IsActive) { <button class="button button-quiet" @onclick="() => Deactivate(item)" disabled="@_busy">Deactivate</button> } else { <button class="button button-quiet" @onclick="() => Activate(item)" disabled="@_busy">Reactivate</button> }</div></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </section>
        </div>
    }
</main>

@code {
    private List<ProductRow> _products = [];
    private ProductForm _form = new();
    private EditContext _editContext;
    private Guid? _editingId;

    public Products()
    {
        _editContext = new EditContext(_form);
        _editContext.OnFieldChanged += (_, _) => ApiErrorFormatter.ClearServerValidationErrors(_editContext);
    }
    private bool _loading = true, _busy, _forbidden;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated && !await Session.RestoreAsync()) { Nav.NavigateTo("/"); return; }
        if (Session.User?.Role != "Owner" && Session.User?.CanManageProducts != true) { _forbidden = true; return; }
        await Load();
    }

    private async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            using var response = await Http.GetAsync("api/products/manage");
            if (!response.IsSuccessStatusCode)
            {
                _products = [];
                _error = await ApiErrorFormatter.FormatAsync(response, "The product catalogue could not be loaded.");
                return;
            }
            _products = await response.Content.ReadFromJsonAsync<List<ProductRow>>() ?? [];
        }
        catch (HttpRequestException) { _error = "The product service could not be reached. Check your connection and retry."; }
        catch (JsonException) { _error = "The product catalogue returned an invalid response. Refresh and try again."; }
        finally { _loading = false; }
    }

    private void Edit(ProductRow item)
    {
        _editingId = item.Id;
        _form = new ProductForm { Sku = item.Sku, Name = item.Name, Category = item.Category, UnitPrice = item.UnitPrice, MinimumStockLevel = item.MinimumStockLevel, HasExpiry = item.HasExpiry };
        ResetEditContext();
        _error = null;
    }

    private void ResetForm() { _editingId = null; _form = new(); ResetEditContext(); _error = null; }
    private void ResetEditContext()
    {
        _editContext = new EditContext(_form);
        _editContext.OnFieldChanged += (_, _) => ApiErrorFormatter.ClearServerValidationErrors(_editContext);
    }

    private async Task Save()
    {
        ApiErrorFormatter.ClearServerValidationErrors(_editContext);
        _busy = true; _error = null;
        var wasEditing = _editingId.HasValue;
        try
        {
            var payload = new { sku = _form.Sku.Trim(), name = _form.Name.Trim(), category = _form.Category, unitPrice = _form.UnitPrice, minimumStockLevel = _form.MinimumStockLevel, hasExpiry = _form.HasExpiry };
            using var response = _editingId.HasValue
                ? await Http.PutAsJsonAsync($"api/products/{_editingId}", payload)
                : await Http.PostAsJsonAsync("api/products", payload);
            if (!response.IsSuccessStatusCode)
            {
                if (response.StatusCode == System.Net.HttpStatusCode.BadRequest
                    && await ApiErrorFormatter.ApplyValidationErrorsAsync(response, _editContext))
                    return;
                var message = await ApiErrorFormatter.FormatAsync(response, response.StatusCode == System.Net.HttpStatusCode.Conflict ? "That SKU is already in use." : "The product could not be saved.");
                if ((int)response.StatusCode >= 500) Toast.ShowError(message); else _error = message;
                return;
            }
            var savedProduct = await response.Content.ReadFromJsonAsync<ProductRow>();
            if (savedProduct is null)
            {
                _error = "The API accepted the product save but returned no product identity. Refresh the product list before continuing.";
                return;
            }

            ResetForm();
            await Load();
            if (!string.IsNullOrWhiteSpace(_error))
            {
                Toast.ShowError("Product saved, but the catalogue could not be refreshed. Use Refresh before receiving stock or making sales.");
                return;
            }
            if (!_products.Any(item => item.Id == savedProduct.Id))
            {
                _error = "The API accepted the save, but the product was not returned by this business catalogue. Refresh and verify the store before receiving stock or making sales.";
                Toast.ShowError("Product save could not be verified in the catalogue.");
                return;
            }

            Toast.ShowSuccess(wasEditing ? "Product updated and verified in the catalogue." : "Product added and verified in the catalogue.");
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }

    private async Task Deactivate(ProductRow item)
    {
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsync($"api/products/{item.Id}/deactivate", null);
            if (!response.IsSuccessStatusCode) { var message = await ApiErrorFormatter.FormatAsync(response, "The product could not be deactivated."); if ((int)response.StatusCode >= 500) Toast.ShowError(message); else _error = message; return; }
            Toast.ShowSuccess("Product deactivated. Historical sales and stock records are retained.");
            await Load();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException) { _error = "The service could not be reached."; }
        finally { _busy = false; }
    }

    private async Task Activate(ProductRow item)
    {
        _busy = true; _error = null;
        try
        {
            using var response = await Http.PostAsync($"api/products/{item.Id}/activate", null);
            if (!response.IsSuccessStatusCode)
            {
                var message = await ApiErrorFormatter.FormatAsync(response, "The product could not be reactivated.");
                if ((int)response.StatusCode >= 500) Toast.ShowError(message); else _error = message;
                return;
            }
            await Load();
            Toast.ShowSuccess("Product reactivated and available in the catalogue.");
        }
        catch (HttpRequestException) { _error = "The service could not be reached. Check your connection and retry."; }
        finally { _busy = false; }
    }

    private static string Money(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"));
    private sealed class ProductForm
    {
        [Required, StringLength(64, MinimumLength = 1)] public string Sku { get; set; } = "";
        [Required, StringLength(200, MinimumLength = 1)] public string Name { get; set; } = "";
        [StringLength(80)] public string? Category { get; set; }
        [Range(typeof(decimal), "0", "10000000")] public decimal UnitPrice { get; set; }
        [Range(0, 1000000)] public int MinimumStockLevel { get; set; } = 5;
        public bool HasExpiry { get; set; }
    }
    private sealed class ProductRow
    {
        public Guid Id { get; set; } public string Sku { get; set; } = ""; public string Name { get; set; } = "";
        public string? Category { get; set; } public decimal UnitPrice { get; set; } public int MinimumStockLevel { get; set; }
        public bool HasExpiry { get; set; } public bool IsActive { get; set; } public int Available { get; set; }
    }
}
